FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

#include        "../../system/include/caseSettings"

dimensions      [0 0 0 1 0 0 0];

internalField   uniform $T_cold;

boundaryField
{
    inlet_cold
    {
        type            fixedValue;
        value           uniform $T_cold;
    }

    outlet_cold
    {
        type            zeroGradient;
    }

    solid
    {
        type            zeroGradient;
    }

    // Exact name required. Same thermal shell as the hot mapped wall.
    cold_fluid_to_hot_fluid
    {
        #include        "../include/thermalShellCoupled"
        value           $internalField;
    }
}

