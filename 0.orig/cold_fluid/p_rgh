FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p_rgh;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

#include        "../../system/include/caseSettings"

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform $pRef;

boundaryField
{
    inlet_cold
    {
        type            fixedFluxPressure;
        value           $internalField;
    }

    outlet_cold
    {
        type            fixedValue;
        value           $internalField;
    }

    "solid.*"
    {
        type            fixedFluxPressure;
        value           $internalField;
    }

    ".*_to_.*"
    {
        type            fixedFluxPressure;
        value           $internalField;
    }

    ".*"
    {
        type            fixedFluxPressure;
        value           $internalField;
    }
}

