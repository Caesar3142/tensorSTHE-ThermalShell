FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

#include        "../../system/include/caseSettings"

dimensions      [0 0 0 1 0 0 0];

internalField   uniform $T_hot;

boundaryField
{
    inlet_hot
    {
        type            fixedValue;
        value           uniform $T_hot;
    }

    outlet_hot
    {
        type            inletOutlet;
        inletValue      uniform $T_hot;
        value           uniform $T_hot;
    }

    "(shell|tubes).*"
    {
        type            zeroGradient;
    }

    // Exact name required. A catch-all ".*" can steal this patch and
    // make the interface adiabatic (zeroGradient).
    hot_fluid_to_cold_fluid
    {
        #include        "../include/thermalShellCoupled"

        // Wall resistance on ONE side only.
        thicknessLayers (0.002);   // thermal shell thickness [m]
        kappaLayers     (16);      // stainless steel [W/m/K]
    }
}

