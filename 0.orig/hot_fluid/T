FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

#include        "../../system/include/caseSettings"

dimensions      [0 0 0 1 0 0 0];

internalField   uniform $T_hot;

boundaryField
{
    inlet_hot
    {
        type            fixedValue;
        value           uniform $T_hot;
    }

    outlet_hot
    {
        type            inletOutlet;
        inletValue      uniform $T_hot;
        value           uniform $T_hot;
    }

    "solid.*"
    {
        type            zeroGradient;
    }

    ".*_to_.*"
    {
        #include        "../include/thermalShellCoupled"
    }

    ".*"
    {
        type            zeroGradient;
    }
}

