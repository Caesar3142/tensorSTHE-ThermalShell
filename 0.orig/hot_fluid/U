FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

#include        "../../system/include/caseSettings"

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    inlet_hot
    {
        type            flowRateInletVelocity;
        massFlowRate    constant $mdotHot;
        rhoInlet        $rhoInlet;
        value           uniform (0 0 0);
    }

    outlet_hot
    {
        type            inletOutlet;
        inletValue      uniform (0 0 0);
        value           uniform (0 0 0);
    }

    "(shell|tubes).*"
    {
        type            noSlip;
    }

    ".*_to_.*"
    {
        type            noSlip;
    }

    ".*"
    {
        type            noSlip;
    }
}

