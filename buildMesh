#!/bin/sh
cd "${0%/*}" || exit                                # Run from this directory
. ${WM_PROJECT_DIR:?}/bin/tools/RunFunctions        # Tutorial run functions
#------------------------------------------------------------------------------

rm -rf 0

runApplication blockMesh

runApplication surfaceFeatureExtract

runApplication snappyHexMesh -overwrite

# shell.stl + tubes.stl are baffles (replacing the old solid.stl enclosure).
# Walking cannot cross those faces, so the two fluids follow the STLs.
runApplication topoSet
runApplication subsetMesh keepCells -overwrite -patches "(shell tubes)"

# Tube (and any two-sided shell) baffles are still coincident
# (tubes / tubes_slave). Merge those pairs back to internal faces so
# splitMeshRegions can couple them as mappedWalls. Single-sided faces
# (shell outer, heads) stay walls. Prism layers stay in each fluid.
runApplication mergeOrSplitBaffles -overwrite

runApplication splitMeshRegions -cellZonesOnly -overwrite

if [ ! -f constant/hot_fluid/polyMesh/points ] || \
   [ ! -f constant/cold_fluid/polyMesh/points ]
then
    echo "Error: splitMeshRegions did not create both region meshes."
    echo "Check log.topoSet, log.subsetMesh and log.splitMeshRegions."
    exit 1
fi

# Fields are already set per region in 0.orig (no changeDictionary).
restore0Dir

#------------------------------------------------------------------------------
