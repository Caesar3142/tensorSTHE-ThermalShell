#!/bin/bash
cd "${0%/*}" || exit                                # Run from this directory
. ${WM_PROJECT_DIR:?}/bin/tools/RunFunctions        # Tutorial run functions
#------------------------------------------------------------------------------

# Decompose each region (multi-region CHT does not use the default mesh).
# Use the same hierarchical cuts in every region decomposeParDict so
# mappedWall twins stay on the same rank.
for region in $(foamListRegions)
do
    runApplication -o -s "$region" decomposePar -region "$region"
done

# Foreground: runParallel redirects to a log, so the terminal looks idle
# and Ctrl-C may not stop mpirun. tee keeps the terminal live and feeds
# the residual plotter.
app=$(getApplication)
nProcs=$(getNumberOfProcessors)
log="log.$app"

: > "$log"
echo "Residual plot: residuals.html   (re-open with: ./plotResiduals --open)"
if [ -f /.dockerenv ]; then
    echo "Open residuals.html from this case folder on the host."
fi
nohup ./plotResiduals --log "$log" --open >/dev/null 2>&1 &

echo "Running $app ($nProcs processes) on $PWD"
set -o pipefail
mpirun --oversubscribe -n "$nProcs" "$app" -parallel 2>&1 | tee -a "$log"

#------------------------------------------------------------------------------
