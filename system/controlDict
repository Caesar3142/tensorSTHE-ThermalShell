FoamFile
{
    version         2;
    format          ascii;
    class           dictionary;
    object          controlDict;
}

application     chtMultiRegionFoam;

startFrom       latestTime;

startTime       0;

stopAt          endTime;

endTime         10;

deltaT          0.01;

writeControl    adjustable;

writeInterval   0.1;

purgeWrite      0;

writeFormat     ascii;

writePrecision  6;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable true;

adjustTimeStep  yes;

maxCo           0.5;

maxDi           10;

maxDeltaT       0.1;

functions
{
    outletHotT
    {
        type            surfaceFieldValue;
        libs            ( fieldFunctionObjects );
        region          hot_fluid;
        regionType      patch;
        name            outlet_hot;
        operation       areaAverage;
        fields          ( T );
        writeFields     false;
        writeControl    timeStep;
        writeInterval   20;
        log             true;
    }
    outletColdT
    {
        type            surfaceFieldValue;
        libs            ( fieldFunctionObjects );
        region          cold_fluid;
        regionType      patch;
        name            outlet_cold;
        operation       areaAverage;
        fields          ( T );
        writeFields     false;
        writeControl    timeStep;
        writeInterval   20;
        log             true;
    }
    wallHeatFluxHot
    {
        type            wallHeatFlux;
        libs            ( fieldFunctionObjects );
        region          hot_fluid;
        patches         ( hot_fluid_to_cold_fluid );
        writeControl    writeTime;
        log             true;
    }
}


