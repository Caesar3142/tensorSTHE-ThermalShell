// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
FoamFile
{
    version         2;
    format          ascii;
    class           dictionary;
    object          controlDict;
}

application     chtMultiRegionSimpleFoam;

startFrom       startTime;

startTime       0;

stopAt          endTime;

// Pseudo-time iterations (not physical seconds).
endTime         500;

deltaT          1;

writeControl    timeStep;

writeInterval   5;

purgeWrite      0;

writeFormat     ascii;

writePrecision  6;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable true;

functions
{
    outletHotT
    {
        type            surfaceFieldValue;
        libs            ( fieldFunctionObjects );
        region          hot_fluid;
        regionType      patch;
        name            outlet_hot;
        operation       areaAverage;
        fields          ( T );
        writeFields     false;
        writeControl    timeStep;
        writeInterval   1;
        log             true;
    }
    outletColdT
    {
        type            surfaceFieldValue;
        libs            ( fieldFunctionObjects );
        region          cold_fluid;
        regionType      patch;
        name            outlet_cold;
        operation       areaAverage;
        fields          ( T );
        writeFields     false;
        writeControl    timeStep;
        writeInterval   1;
        log             true;
    }
    outletHotMdot
    {
        type            surfaceFieldValue;
        libs            ( fieldFunctionObjects );
        region          hot_fluid;
        regionType      patch;
        name            outlet_hot;
        operation       sum;
        fields          ( phi );
        writeFields     false;
        writeControl    timeStep;
        writeInterval   1;
        log             true;
    }
    outletColdMdot
    {
        type            surfaceFieldValue;
        libs            ( fieldFunctionObjects );
        region          cold_fluid;
        regionType      patch;
        name            outlet_cold;
        operation       sum;
        fields          ( phi );
        writeFields     false;
        writeControl    timeStep;
        writeInterval   1;
        log             true;
    }
    wallHeatFluxHot
    {
        type            wallHeatFlux;
        libs            ( fieldFunctionObjects );
        region          hot_fluid;
        patches         ( hot_fluid_to_cold_fluid );
        writeControl    writeTime;
        log             true;
    }
    wallHeatFluxCold
    {
        type            wallHeatFlux;
        libs            ( fieldFunctionObjects );
        region          cold_fluid;
        patches         ( cold_fluid_to_hot_fluid );
        writeControl    writeTime;
        log             true;
    }
}


