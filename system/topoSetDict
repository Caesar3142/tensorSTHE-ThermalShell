FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      topoSetDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// After snappyHexMesh, shell.stl and tubes.stl are baffles
// (shell / shell_slave, tubes / tubes_slave). Walking cannot cross
// those faces, so the two fluids follow the STLs rather than a
// geometric cylinder. The enclosure is shell + tubes (old solid.stl).

actions
(
    {
        name        hot_fluid;
        type        cellSet;
        action      new;
        source      regionToCell;
        insidePoints ((0.11 0.01 0.01));
    }

    {
        name        cold_fluid;
        type        cellSet;
        action      new;
        source      regionToCell;
        insidePoints ((1.80 0.01 -0.22));
    }

    {
        name        keepCells;
        type        cellSet;
        action      new;
        source      cellToCell;
        set         hot_fluid;
    }

    {
        name        keepCells;
        type        cellSet;
        action      add;
        source      cellToCell;
        set         cold_fluid;
    }

    {
        name        hot_fluid;
        type        cellZoneSet;
        action      new;
        source      setToCellZone;
        set         hot_fluid;
    }

    {
        name        cold_fluid;
        type        cellZoneSet;
        action      new;
        source      setToCellZone;
        set         cold_fluid;
    }
);

