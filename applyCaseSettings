#!/bin/bash
# Write numeric values from system/include/caseSettings into 0/ field files.
# Macros ($mdotHot, …) are not always re-expanded when decomposePar reuses
# existing processor*/0/ directories.
cd "${0%/*}" || exit

if [ ! -d 0 ]; then
    echo "Error: 0/ missing. Run restore0Dir or ./Run first." >&2
    exit 1
fi

caseSetting() {
    awk -v key="$1" '
        $1 == key { v = $2; gsub(/;/, "", v); print v; exit }
    ' system/include/caseSettings
}

mdotHot=$(caseSetting mdotHot)
mdotCold=$(caseSetting mdotCold)
T_hot=$(caseSetting T_hot)
T_cold=$(caseSetting T_cold)
rhoInlet=$(caseSetting rhoInlet)
kInlet=$(caseSetting kInlet)
epsilonInlet=$(caseSetting epsilonInlet)

for v in mdotHot mdotCold T_hot T_cold rhoInlet kInlet epsilonInlet; do
    if [ -z "${!v}" ]; then
        echo "Error: $v not found in system/include/caseSettings" >&2
        exit 1
    fi
done

foamDictionary 0/hot_fluid/U \
    -entry "boundaryField.inlet_hot.massFlowRate" -set "constant $mdotHot"
foamDictionary 0/hot_fluid/U \
    -entry "boundaryField.inlet_hot.rhoInlet" -set "$rhoInlet"

foamDictionary 0/cold_fluid/U \
    -entry "boundaryField.inlet_cold.massFlowRate" -set "constant $mdotCold"
foamDictionary 0/cold_fluid/U \
    -entry "boundaryField.inlet_cold.rhoInlet" -set "$rhoInlet"

foamDictionary 0/hot_fluid/T -entry internalField -set "uniform $T_hot"
foamDictionary 0/hot_fluid/T \
    -entry "boundaryField.inlet_hot.value" -set "uniform $T_hot"

foamDictionary 0/cold_fluid/T -entry internalField -set "uniform $T_cold"
foamDictionary 0/cold_fluid/T \
    -entry "boundaryField.inlet_cold.value" -set "uniform $T_cold"

for region in hot_fluid cold_fluid; do
    inlet="inlet_${region/_fluid/}"
    foamDictionary "0/$region/k" -entry internalField -set "uniform $kInlet"
    foamDictionary "0/$region/k" \
        -entry "boundaryField.$inlet.value" -set "uniform $kInlet"
    foamDictionary "0/$region/epsilon" -entry internalField -set "uniform $epsilonInlet"
    foamDictionary "0/$region/epsilon" \
        -entry "boundaryField.$inlet.value" -set "uniform $epsilonInlet"
done

echo "Applied caseSettings: mdotHot=$mdotHot mdotCold=$mdotCold T_hot=$T_hot T_cold=$T_cold"
